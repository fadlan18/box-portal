<template>
  <div class="space-y-6">
    <div>
      <h1 class="font-display text-2xl font-bold text-white mb-1">Pesan Layanan</h1>
      <p class="text-sm text-gray-400">Pilih layanan yang Anda butuhkan</p>
    </div>

    <!-- Kategori layanan -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <div v-for="svc in serviceList" :key="svc.id"
        class="glass rounded-2xl p-6 hover:bg-white/5 transition-all cursor-pointer"
        :class="selected?.id === svc.id ? 'ring-2 ring-blue-500' : ''"
        @click="selected = svc">
        <div class="flex items-start justify-between mb-3">
          <div class="text-3xl">{{ svc.icon }}</div>
          <span class="text-xs font-semibold px-2 py-1 rounded-full"
            style="background:rgba(59,130,246,0.15);color:#60a5fa">
            {{ svc.category }}
          </span>
        </div>
        <h3 class="font-bold text-white text-lg mb-1">{{ svc.name }}</h3>
        <p class="text-gray-400 text-sm mb-3">{{ svc.description }}</p>
        <div class="font-bold text-xl" style="color:#60a5fa">
          {{ fmtCurrency(svc.price) }}
          <span class="text-xs font-normal text-gray-500 ml-1">/ {{ svc.period }}</span>
        </div>
      </div>
    </div>

    <!-- Form order -->
    <div v-if="selected" class="glass rounded-2xl p-6 space-y-4">
      <h2 class="font-bold text-white text-lg">Detail Pesanan — {{ selected.name }}</h2>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div>
          <label class="text-xs font-semibold text-gray-400 block mb-2">Nama Domain (opsional)</label>
          <input v-model="form.domain" type="text" placeholder="contoh.com"
            class="w-full px-4 py-3 rounded-xl text-sm outline-none text-white"
            style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.09)" />
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-400 block mb-2">Nomor WhatsApp</label>
          <input v-model="form.phone" type="text" placeholder="08xxxxxxxxxx"
            class="w-full px-4 py-3 rounded-xl text-sm outline-none text-white"
            style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.09)" />
        </div>
        <div class="lg:col-span-2">
          <label class="text-xs font-semibold text-gray-400 block mb-2">Catatan / Kebutuhan Khusus</label>
          <textarea v-model="form.notes" rows="3" placeholder="Jelaskan kebutuhan Anda..."
            class="w-full px-4 py-3 rounded-xl text-sm outline-none text-white resize-none"
            style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.09)"></textarea>
        </div>
      </div>

      <!-- Summary -->
      <div class="rounded-xl p-4" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06)">
        <div class="flex justify-between text-sm mb-2">
          <span class="text-gray-400">Layanan</span>
          <span class="text-white font-semibold">{{ selected.name }}</span>
        </div>
        <div class="flex justify-between text-sm mb-2">
          <span class="text-gray-400">Periode</span>
          <span class="text-white">{{ selected.period }}</span>
        </div>
        <div class="flex justify-between font-bold mt-3 pt-3" style="border-top:1px solid rgba(255,255,255,0.06)">
          <span class="text-white">Total</span>
          <span style="color:#60a5fa">{{ fmtCurrency(selected.price) }}</span>
        </div>
      </div>

      <p v-if="error" class="text-red-400 text-sm">⚠️ {{ error }}</p>
      <p v-if="success" class="text-green-400 text-sm">✅ {{ success }}</p>

      <button @click="order" :disabled="loading"
        class="w-full py-4 rounded-xl font-bold text-white text-base transition-all"
        style="background:#1a4fa0"
        :style="loading ? 'opacity:0.6' : ''">
        {{ loading ? 'Memproses...' : '🛒 Buat Invoice & Pesan Sekarang' }}
      </button>
    </div>
  </div>
</template>

<script setup lang="ts">
definePageMeta({ middleware: 'auth' })

const { user } = useCustomAuth()
const selected = ref<any>(null)
const loading = ref(false)
const error = ref('')
const success = ref('')
const form = reactive({ domain: '', phone: '', notes: '' })

// Daftar layanan yang tersedia
const serviceList = [
  {
    id: 'web-company',
    icon: '🌐',
    name: 'Website Company Profile',
    description: 'Website profesional untuk bisnis Anda dengan desain modern dan responsif',
    price: 3500000,
    period: 'proyek',
    category: 'Website',
  },
  {
    id: 'web-toko',
    icon: '🛍️',
    name: 'Toko Online / E-Commerce',
    description: 'Platform belanja online lengkap dengan manajemen produk dan pembayaran',
    price: 7500000,
    period: 'proyek',
    category: 'Website',
  },
  {
    id: 'web-landing',
    icon: '📄',
    name: 'Landing Page',
    description: 'Halaman promosi yang dioptimalkan untuk konversi tinggi',
    price: 1500000,
    period: 'proyek',
    category: 'Website',
  },
  {
    id: 'maintenance',
    icon: '🔧',
    name: 'Maintenance Website',
    description: 'Perawatan dan pembaruan website bulanan agar selalu optimal',
    price: 500000,
    period: 'bulan',
    category: 'Maintenance',
  },
]

async function order() {
  if (!selected.value) return
  if (!user.value?.id) return
  error.value = ''
  loading.value = true

  try {
    const res: any = await $fetch('/api/billing/create-invoice', {
      method: 'POST',
      credentials: 'include',
      body: {
        user_id: user.value.id,
        user_name: user.value.name,
        user_email: user.value.email,
        service: selected.value,
        form: form,
      },
    })

    if (res.ok) {
      success.value = `Invoice ${res.invoice.invoice_number} berhasil dibuat! Mengalihkan ke halaman pembayaran...`
      setTimeout(() => {
        window.location.href = res.invoice.payment_url
      }, 2000)
    }
  } catch (e: any) {
    error.value = e?.data?.message || 'Gagal membuat pesanan'
  } finally {
    loading.value = false
  }
}

function fmtCurrency(amount: number) {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency', currency: 'IDR', maximumFractionDigits: 0
  }).format(amount)
}
</script>
